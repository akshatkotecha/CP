import java.util.*;
import java.lang.*;
import java.io.*;
 
public class Codechef
{
	public static int gcd(int a, int b) {
        	if (b == 0) return a;
        	return gcd(b, a % b);
    		}
	public static int lcm(int a, int b) {
    		return (a * b) / gcd(a, b);
		}
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc=new Scanner(System.in);
		int t=sc.nextInt();
		while(t-->0)
		{
			int n=sc.nextInt();
			int k=sc.nextInt();
		//	int a[]=new int[n];
	    //   for(int i=0;i<n;i++) a[i]=sc.nextInt();
	        String s=sc.next();
	        if(2*k>n) System.out.println(-1);
	        else{
	            int c=0;
	            for(int i=0;i<k;i++){
	                if(s.charAt(i)=='L') c++;
	            }
	            for(int i=0;i<k;i++){
	                if(s.charAt(n-i-1)=='R') c++;
	            }
	            System.out.println(c);
	        }
	    
		}
	}
}
 
 