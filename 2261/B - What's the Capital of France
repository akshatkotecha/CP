    public static void reverseSort(int[] a) {
        Arrays.sort(a);
 
        int left = 0;
        int right = a.length - 1;
 
        while (left < right) {
            int temp = a[left];
            a[left] = a[right];
            a[right] = temp;
 
            left++;
            right--;
        }
    }
 
    // ==================== BINARY SEARCH ====================
 
    public static int lowerbound(int[] a, int value) {
        int low = 0, high = a.length;
 
        while (low < high) {
            int mid = low + (high - low) / 2;
 
            if (a[mid] < value)
                low = mid + 1;
            else
                high = mid;
        }
 
        return low;
    }
 
    public static int upperbound(int[] a, int value) {
        int low = 0, high = a.length;
 
        while (low < high) {
            int mid = low + (high - low) / 2;
 
            if (a[mid] <= value)
                low = mid + 1;
            else
                high = mid;
        }
 
        return low;
    }
 
