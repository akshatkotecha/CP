    public static Map<Integer, List<Integer>> getIndexMap(int[] nums) {
        Map<Integer, List<Integer>> map = new HashMap<>();
 
        for (int i = 0; i < nums.length; i++) {
            map.computeIfAbsent(nums[i], k -> new ArrayList<>()).add(i);
        }
 
        return map;
    }
 
