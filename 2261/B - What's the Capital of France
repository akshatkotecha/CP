    // ==================== PRIME ====================
 
    public static boolean isPrime(int n) {
        if (n < 2) return false;
        if (n < 4) return true;
        if (n % 2 == 0 || n % 3 == 0) return false;
 
        for (int i = 5; i <= n / i; i += 6) {
            if (n % i == 0 || n % (i + 2) == 0)
                return false;
        }
 
        return true;
    }
 
    public static boolean[] sievePrime(int n) {
        boolean[] p = new boolean[n + 1];
 
        Arrays.fill(p, true);
        p[0] = false;
        if (n >= 1) p[1] = false;
 
        for (int i = 2; i <= n / i; i++) {
            if (p[i]) {
                for (int j = i * i; j <= n; j += i)
                    p[j] = false;
            }
        }
 
        return p;
    }
 
    // ==================== SORTING ====================
 
    public static void sort(int[] a) {
