    // ==================== MATH HELPERS ====================
 
    public static long power(long a, long b) {
        long ans = 1;
 
        while (b > 0) {
            if ((b & 1) == 1)
                ans *= a;
 
            a *= a;
            b >>= 1;
        }
 
        return ans;
    }
 
    public static long powerMod(long a, long b) {
        long ans = 1;
 
        a %= mod;
 
        while (b > 0) {
            if ((b & 1) == 1)
                ans = (ans * a) % mod;
 
            a = (a * a) % mod;
            b >>= 1;
        }
 
        return ans;
    }
 
